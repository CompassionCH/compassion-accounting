<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="account_reconcile_compassion_ee.BankRecRecordFormLineIds"
        t-inherit="account_accountant.BankRecRecordFormLineIds"
        t-inherit-mode="extension"
    >
        <xpath expr="//t[@name='col_taxes']" position="after">
            <!-- Product -->
            <t t-if="column[0] === 'product'" name="col_product">
                <td
                    class="o_data_cell o_field_cell o_field_widget o_list_many2one"
                    t-att-class="{'o_invalid_cell': invalidFields.includes('product')}"
                    field="product_id"
                    t-att-title="line.data.product_id[1]"
                    t-out="line.data.product_id[1]"
                />
            </t>
            <!-- Contract -->
            <t t-if="column[0] === 'contract'" name="col_contract">
                <td
                    class="o_data_cell o_field_cell o_field_widget o_list_many2one"
                    t-att-class="{'o_invalid_cell': invalidFields.includes('contract')}"
                    field="contract_id"
                    t-att-title="line.data.contract_id[1]"
                    t-out="line.data.contract_id[1]"
                />
            </t>
        </xpath>
    </t>

    <t
        t-name="account_reconcile_compassion_ee.BankRecRecordNotebookManualOperations"
        t-inherit="account_accountant.BankRecRecordNotebookManualOperations"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[@name='account_id']" position="before">
            <div
                name="product_id"
                t-if="line.data.flag !== 'liquidity'"
                class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0"
            >
                <div
                    class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900"
                >
                    <label
                        class="o_form_label"
                        t-att-class="{'o_field_invalid': invalidFields.includes('product'), 'o_form_label_readonly': reconciled}"
                    >Product</label>
                </div>
                <div
                    class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 w-100 mb-1"
                >
                    <div
                        class="o_field_widget o_field_many2one"
                        t-att-class="{'o_field_invalid': invalidFields.includes('product')}"
                    >
                        <Many2OneField
                            name="'product_id'"
                            record="line"
                            canOpen="false"
                            readonly="reconciled"
                            canQuickCreate="false"
                            domain="[['company_id', 'in', [false, data.company_id[0]]],['property_account_income_id.is_off_balance','=',false],['property_account_expense_id.is_off_balance','=',false]]"
                        />
                    </div>
                </div>
            </div>
            <div
                name="contract_id"
                t-if="line.data.flag !== 'liquidity'"
                class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0"
            >
                <div
                    class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900"
                >
                    <label
                        class="o_form_label"
                        t-att-class="{'o_field_invalid': invalidFields.includes('contract'), 'o_form_label_readonly': reconciled}"
                    >Contract</label>
                </div>
                <div
                    class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 w-100 mb-1"
                >
                    <div
                        class="o_field_widget o_field_many2one"
                        t-att-class="{'o_field_invalid': invalidFields.includes('contract')}"
                    >
                        <Many2OneField
                            name="'contract_id'"
                            record="line"
                            canOpen="false"
                            readonly="reconciled"
                            canQuickCreate="false"
                            domain="[['partner_id', '=', data.partner_id[0]]]"
                        />
                    </div>
                </div>
            </div>

        </xpath>
        <xpath
            expr="//Many2OneField[@name=&quot;'partner_id'&quot;]"
            position="attributes"
        >
            <attribute name="placeholder">data.partner_name</attribute>
        </xpath>
    </t>
</templates>
