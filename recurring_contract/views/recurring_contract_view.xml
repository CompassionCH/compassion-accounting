<odoo>
    <!-- Contract list view -->
    <record id="view_recurring_contract_tree" model="ir.ui.view">
        <field name="name">recurring.contract.list</field>
        <field name="model">recurring.contract</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="state in ('terminated','cancelled')"
                decoration-success="state == 'waiting'"
                decoration-primary="state == 'draft'"
            >
                <field name="reference" />
                <field name="partner_id" />
                <field name="start_date" />
                <field name="activation_date" />
                <field name="end_date" />
                <field name="payment_mode_id" />
                <field name="total_amount" />
                <field name="state" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
                <field
                    name="pricelist_id"
                    optional="hide"
                    groups="product.group_product_pricelist"
                />
            </list>
        </field>
    </record>

    <!-- Contract form view -->
    <record id="view_recurring_contract_form" model="ir.ui.view">
        <field name="name">recurring.contract.form</field>
        <field name="model">recurring.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" readonly="1" />
                    <button
                        name="contract_waiting"
                        class="oe_highlight"
                        string="Validate"
                        invisible="state != 'draft'"
                        type="object"
                    />
                    <button
                        name="action_cancel_draft"
                        type="object"
                        string="Set back to draft"
                        invisible="state != 'cancelled'"
                    />
                    <button
                        name="%(action_end_contract)d"
                        type="action"
                        string="Terminate"
                        class="oe_highlight"
                        invisible="state in ('terminated','cancelled') or end_date"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="button_generate_invoices"
                            type="object"
                            class="oe_inline oe_stat_button"
                            icon="fa-refresh"
                            string="Generate invoices"
                            invisible="state not in ('waiting','active')"
                        />
                        <button
                            name="open_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                        >
                            <field
                                name="nb_invoices"
                                widget="statinfo"
                                string="Open invoices"
                            />
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field
                                name="reference"
                                default_focus="1"
                                readonly="state != 'draft'"
                            />
                        </h1>
                    </div>
                    <group>
                        <group
                            string="Contract Details"
                            name="contract_details"
                        >
                            <field
                                name="partner_id"
                                readonly="state != 'draft'"
                                options="{'create': false, 'm2o_dialog': false}"
                            />
                            <field
                                name="group_id"
                                domain="[('partner_id', '=', partner_id)]"
                                context="{'default_partner_id': partner_id, 'contract_id': id,}"
                                options="{'no_quick_create': True}"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field
                                name="pricelist_id"
                                groups="product.group_product_pricelist"
                            />
                            <field name="comment" />
                        </group>
                        <group string="Dates" name="contract_dates">
                            <field name="start_date" readonly="1" />
                            <field name="activation_date" readonly="1" />
                            <field name="end_date" />
                            <field
                                name="end_reason_id"
                                invisible="state not in ('terminated','cancelled')"
                            />
                        </group>
                    </group>
                    <group>
                        <group
                            string="Marketing Information"
                            name="contract_marketing"
                        >
                            <field
                                name="medium_id"
                                domain="[('type', '=', 'manual')]"
                            />
                            <field
                                name="campaign_id"
                                options="{'no_create': True}"
                            />
                            <field name="source_id" />
                        </group>
                        <group
                            string="Payment Information"
                            name="contract_payment"
                        >
                            <field name="last_paid_invoice_date" />
                            <field name="months_paid" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract lines">
                            <field name="contract_line_ids" />
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" />
                            </group>
                            <group class="oe_inline" />
                        </page>
                        <page string="Related invoice lines">
                            <field name="invoice_line_ids">
                                <list>
                                    <field name="move_id" />
                                    <field name="name" />
                                    <field name="due_date" />
                                    <field name="quantity" />
                                    <field name="price_unit" />
                                    <field name="price_subtotal" />
                                    <field
                                        name="parent_state"
                                        widget="badge"
                                        decoration-info="parent_state == 'draft'"
                                        decoration-success="parent_state == 'posted'"
                                    />
                                    <field
                                        name="payment_state"
                                        widget="badge"
                                        decoration-info="payment_state == 'in_payment'"
                                        decoration-success="payment_state == 'paid'"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Contract line list view -->
    <record id="view_recurring_contract_line_tree" model="ir.ui.view">
        <field name="name">recurring.contract.line.list</field>
        <field name="model">recurring.contract.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id" />
                <field name="pricelist_item_count" column_invisible="1" />
                <field
                    name="amount"
                    force_save="1"
                    readonly="pricelist_item_count > 0"
                />
                <field name="quantity" />
                <field name="subtotal" />
            </list>
        </field>
    </record>

    <record id="view_recurring_contract_filter" model="ir.ui.view">
        <field name="name">recurring.contract.select</field>
        <field name="model">recurring.contract</field>
        <field name="arch" type="xml">
            <search string="Search contract">
                <field
                    name="reference"
                    string="Contract"
                    filter_domain="['|','|', ('reference','ilike',self), ('partner_id','child_of',self), ('payment_mode_id', 'ilike', self)]"
                />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state','=', 'draft')]"
                />
                <filter
                    name="waiting"
                    string="Waiting"
                    domain="[('state','in', ('waiting','mandate'))]"
                />
                <filter
                    name="active"
                    string="Active"
                    domain="[('activation_date', '!=', False), ('state', 'not in', ('cancelled','terminated'))]"
                    help="Active Contracts"
                />
                <filter
                    name="finished"
                    string="Finished"
                    domain="[('state','=', 'terminated')]"
                />
                <field name="partner_id" operator="child_of" />
                <field name="payment_mode_id" string="Payment term" />
                <group expand="0" string="Group By...">
                    <filter
                        string="Partner"
                        name="partner"
                        domain="[]"
                        context="{'group_by':'partner_id'}"
                    />
                    <filter
                        string="Start date"
                        name="start_date"
                        domain="[]"
                        context="{'group_by':'start_date'}"
                    />
                    <filter
                        string="End date"
                        name="end_date"
                        domain="[]"
                        context="{'group_by':'end_date'}"
                    />
                    <filter
                        string="Payment mode"
                        name="payment_mode"
                        domain="[]"
                        context="{'group_by':'payment_mode_id'}"
                    />
                    <filter
                        string="Total"
                        name="total"
                        domain="[]"
                        context="{'group_by':'total_amount'}"
                    />
                    <filter
                        string="Status"
                        name="state"
                        domain="[]"
                        context="{'group_by':'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Sidebar action, called from menu_recurring_contract_form menuitem -->
    <record id="action_recurring_contract_form" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">recurring.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add a contract.
            </p>
            <p>
                OpenERP helps you to generate recurrent invoices.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_contracts_section"
        parent="account.menu_finance"
        name="Contracts"
        sequence="2"
    />
    <menuitem
        id="menu_recurring_contract_form"
        parent="menu_contracts_section"
        action="action_recurring_contract_form"
        sequence="5"
    />

    <record id="action_invoice_automatic_generation" model="ir.actions.server">
        <field name="name">Launch invoices generation</field>
        <field name="model_id" ref="model_recurring_contract_group" />
        <field name="state">code</field>
        <field name="code">model.generate_from_cron()</field>
    </record>

    <menuitem
        id="menu_invoice_automatic_generation"
        name="Launch invoices generation"
        parent="menu_contracts_section"
        sequence="10"
        action="action_invoice_automatic_generation"
        groups="account.group_account_manager"
    />
</odoo>
