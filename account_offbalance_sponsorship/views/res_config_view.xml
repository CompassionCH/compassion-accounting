<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_off_balance_setting" model="ir.ui.view">
        <field name="name">Offbalance accounting settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Off-Balance Accounting Settings">
                    <setting
                        string="Asset Off-Balance Account"
                        company_dependent="1"
                    >
                        <field
                            name="off_balance_asset_account_id"
                            readonly="0"
                            domain="[('company_id', '=', company_id),('account_type', 'like', 'asset'), ('is_off_balance', '=', True)]"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
