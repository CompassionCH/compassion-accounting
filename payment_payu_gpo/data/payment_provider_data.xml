<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="payment_provider_payu_gpo" model="payment.provider">
        <field name="name">PayU</field>
        <field name="code">payu_gpo</field>
        <field name="state">disabled</field>
        <field name="module_id" ref="base.module_payment_payu_gpo" />
        <field name="redirect_form_view_id" ref="redirect_form" />
        <field name="inline_form_view_id" ref="inline_form" />
        <field name="allow_tokenization">True</field>
        <field
            name="payment_method_ids"
            eval="[Command.set([ref('payment.payment_method_card'), ref('payment.payment_method_blik')])]"
        />
    </record>
</odoo>
