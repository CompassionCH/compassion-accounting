<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_transaction_form" model="ir.ui.view">
        <field name="name">PayU GPO Transaction Form</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form" />
        <field name="arch" type="xml">
            <field name="provider_reference" position="after">
                <field name="payu_gpo_status" invisible="provider_code != 'payu_gpo'" />
                <field
                    name="payu_gpo_unconfirmed"
                    invisible="provider_code != 'payu_gpo'"
                />
                <field name="payu_gpo_held" invisible="provider_code != 'payu_gpo'" />
            </field>
        </field>
    </record>

    <record id="payment_transaction_search" model="ir.ui.view">
        <field name="name">PayU GPO Transaction Search</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_search" />
        <field name="arch" type="xml">
            <field name="partner_name" position="after">
                <separator />
                <filter
                    string="Unconfirmed by PayU"
                    name="payu_gpo_unconfirmed"
                    domain="[('payu_gpo_unconfirmed', '=', True)]"
                />
                <filter
                    string="Held for a PayU check"
                    name="payu_gpo_held"
                    domain="[('payu_gpo_held', '=', True)]"
                />
            </field>
        </field>
    </record>
</odoo>
