<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="redirect_form">
        <!-- PayU returns a unique payment page URL per order. -->
        <form t-att-action="api_url" method="get">
            <t t-foreach="url_params" t-as="param">
                <input type="hidden" t-att-name="param" t-att-value="url_params[param]" />
            </t>
        </form>
    </template>

    <template id="inline_form">
        <!-- Cards only: PayU Secure Form, mounted by payment_form.js. -->
        <t
            t-set="payu_gpo_values"
            t-value="provider_sudo._payu_gpo_get_inline_form_values(pm_sudo.code)"
        />
        <t t-if="payu_gpo_values">
            <!-- The Secure Form asks no name: 3DS and the receipt need it. -->
            <div class="mt-2">
                <label
                    t-attf-for="o_payu_gpo_cardholder_{{pm_sudo.id}}"
                    class="form-label"
                >Name on card</label>
                <input
                    type="text"
                    name="o_payu_gpo_cardholder_name"
                    t-attf-id="o_payu_gpo_cardholder_{{pm_sudo.id}}"
                    class="form-control"
                    autocomplete="cc-name"
                    maxlength="100"
                />
            </div>
            <div
                name="o_payu_gpo_card_container"
                t-attf-id="o_payu_gpo_card_{{pm_sudo.id}}"
                class="mt-2"
                t-att-data-payu-gpo-inline-form-values="payu_gpo_values"
            />
        </t>
    </template>
</odoo>
