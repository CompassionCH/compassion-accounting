<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="redirect_form">
        <!-- PayU returns a unique payment page URL per order. -->
        <form t-att-action="api_url" method="get">
            <t t-foreach="url_params" t-as="param">
                <input type="hidden" t-att-name="param" t-att-value="url_params[param]" />
            </t>
        </form>
    </template>

    <template id="inline_form">
        <!-- Cards only: PayU Secure Form, mounted by payment_form.js. -->
        <t
            t-set="payu_gpo_values"
            t-value="provider_sudo._payu_gpo_get_inline_form_values(pm_sudo.code)"
        />
        <t t-if="payu_gpo_values">
            <!-- The Secure Form asks no name: 3DS and the receipt need it.
                 The page may prefill it with payu_gpo_cardholder_firstname
                 and payu_gpo_cardholder_lastname. -->
            <div class="row mt-2">
                <div class="col-sm-6">
                    <label
                        t-attf-for="o_payu_gpo_cardholder_firstname_{{pm_sudo.id}}"
                        class="form-label"
                    >First name</label>
                    <input
                        type="text"
                        name="o_payu_gpo_cardholder_firstname"
                        t-attf-id="o_payu_gpo_cardholder_firstname_{{pm_sudo.id}}"
                        class="form-control"
                        autocomplete="cc-given-name"
                        maxlength="100"
                        t-att-value="payu_gpo_cardholder_firstname"
                    />
                </div>
                <div class="col-sm-6 mt-2 mt-sm-0">
                    <label
                        t-attf-for="o_payu_gpo_cardholder_lastname_{{pm_sudo.id}}"
                        class="form-label"
                    >Last name</label>
                    <input
                        type="text"
                        name="o_payu_gpo_cardholder_lastname"
                        t-attf-id="o_payu_gpo_cardholder_lastname_{{pm_sudo.id}}"
                        class="form-control"
                        autocomplete="cc-family-name"
                        maxlength="100"
                        t-att-value="payu_gpo_cardholder_lastname"
                    />
                </div>
            </div>
            <div
                name="o_payu_gpo_card_container"
                t-attf-id="o_payu_gpo_card_{{pm_sudo.id}}"
                class="mt-2"
                t-att-data-payu-gpo-inline-form-values="payu_gpo_values"
            />
        </t>
    </template>
</odoo>
