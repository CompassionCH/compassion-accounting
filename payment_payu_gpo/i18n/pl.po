#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_provider__code
msgid "Code"
msgstr "Kod"

#. module: payment_payu_gpo
#. odoo-javascript
#: code:addons/payment_payu_gpo/static/src/js/payment_form.esm.js:0
msgid "Incorrect payment details"
msgstr "Nieprawidłowe dane płatności"

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_transaction__payu_gpo_token_retry_date
msgid "Last time the cron tried to save the card of this payment."
msgstr "Ostatni raz, kiedy cron próbował zapisać kartę tej płatności."

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_transaction__payu_gpo_sync_date
msgid ""
"Last time the status of this pending payment was read from PayU (cron or "
"payment status page)."
msgstr ""
"Ostatni odczyt statusu tej oczekującej płatności z PayU (zadanie cykliczne "
"lub strona statusu płatności)."

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_transaction__payu_gpo_card_mask
msgid ""
"Masked number of the card of this payment, used to find its token among the "
"buyer's cards when PayU did not return it."
msgstr ""
"Zamaskowany numer karty tej płatności, używany do odnalezienia jej tokenu "
"wśród kart kupującego, gdy PayU go nie zwróciło."

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_transaction__payu_gpo_card_token
msgid ""
"Multi-use TOKC_ token PayU returned for the card of this payment; saved as a"
" payment token once the payment is completed."
msgstr ""
"Wielokrotny token TOKC_ zwrócony przez PayU dla karty tej płatności; "
"zapisywany jako token płatności po zakończeniu płatności."

#. module: payment_payu_gpo
#: model_terms:ir.ui.view,arch_db:payment_payu_gpo.inline_form
msgid "Name on card"
msgstr "Imię i nazwisko na karcie"

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_transaction__payu_gpo_cardholder_name
msgid ""
"Name on the card, as typed in the card form: sent to PayU for 3-D Secure and"
" as the buyer's name."
msgstr ""
"Imię i nazwisko na karcie, wpisane w formularzu karty: przesyłane do PayU na"
" potrzeby 3-D Secure i jako dane kupującego."

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_provider__payu_gpo_client_id
msgid "OAuth client_id"
msgstr "OAuth client_id"

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_provider__payu_gpo_client_secret
msgid "OAuth client_secret"
msgstr "OAuth client_secret"

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_provider__payu_gpo_pos_id
msgid "POS ID"
msgstr "ID punktu płatności (POS ID)"

#. module: payment_payu_gpo
#: model:payment.provider,name:payment_payu_gpo.payment_provider_payu_gpo
msgid "PayU"
msgstr "PayU"

#. module: payment_payu_gpo
#: model:ir.model.fields.selection,name:payment_payu_gpo.selection__payment_provider__code__payu_gpo
msgid "PayU GPO"
msgstr "PayU GPO"

#. module: payment_payu_gpo
#: model:ir.actions.server,name:payment_payu_gpo.cron_sync_pending_ir_actions_server
msgid "PayU GPO: read the status of pending payments"
msgstr "PayU GPO: odczytaj status oczekujących płatności"

#. module: payment_payu_gpo
#: model:ir.actions.server,name:payment_payu_gpo.cron_retry_tokenization_ir_actions_server
msgid "PayU GPO: save the cards of completed payments"
msgstr "PayU GPO: zapisz karty zakończonych płatności"

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU asked for the cardholder (%s): the charge will fail."
msgstr ""
"PayU wymaga obecności posiadacza karty (%s): obciążenie się nie powiedzie."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU canceled the refund."
msgstr "PayU anulowało zwrot."

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_transaction__payu_gpo_card_mask
msgid "PayU card number"
msgstr "Numer karty PayU"

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_transaction__payu_gpo_token_retry_date
msgid "PayU card save retried on"
msgstr "Ponowna próba zapisu karty PayU"

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_transaction__payu_gpo_card_token
msgid "PayU card token"
msgstr "Token karty PayU"

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_transaction__payu_gpo_cardholder_name
msgid "PayU cardholder name"
msgstr "Imię i nazwisko posiadacza karty (PayU)"

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid ""
"PayU did not answer (%s). The payment may have been made: PayU's "
"notification will update it."
msgstr ""
"PayU nie odpowiedziało (%s). Płatność mogła zostać zrealizowana: "
"powiadomienie PayU ją zaktualizuje."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU did not return a payment page."
msgstr "PayU nie zwróciło strony płatności."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid ""
"PayU holds this payment until it is captured: automatic collection must be "
"enabled on the PayU point of sale."
msgstr ""
"PayU wstrzymuje tę płatność do jej odebrania: w punkcie płatności PayU musi "
"być włączony automatyczny odbiór."

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_token__payu_gpo_recurring
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_transaction__payu_gpo_recurring
msgid "PayU recurring card"
msgstr "Karta cykliczna PayU"

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU reported %(payu)s, this payment is %(ours)s."
msgstr "PayU zgłosiło %(payu)s, ta płatność to %(ours)s."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU reported the amount %s (in minor units)."
msgstr "PayU zgłosiło kwotę %s (w groszach)."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU reported the currency %s."
msgstr "PayU zgłosiło walutę %s."

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_transaction__payu_gpo_sync_date
msgid "PayU status read on"
msgstr "Status PayU odczytany"

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU: %s"
msgstr "PayU: %s"

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU: a saved card can only be charged without the buyer."
msgstr "PayU: zapisaną kartę można obciążyć tylko bez udziału kupującego."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/controllers/main.py:0
msgid "PayU: invalid card token."
msgstr "PayU: nieprawidłowy token karty."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU: no transaction found for reference %s."
msgstr "PayU: nie znaleziono transakcji o numerze referencyjnym %s."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU: received data with invalid status: %s"
msgstr "PayU: otrzymano dane z nieprawidłowym statusem: %s"

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU: received data with missing reference."
msgstr "PayU: otrzymano dane bez numeru referencyjnego."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/controllers/main.py:0
msgid "PayU: received tampered payment request data."
msgstr "PayU: otrzymano zmodyfikowane dane żądania płatności."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid "PayU: the transaction is not linked to a token."
msgstr "PayU: transakcja nie jest powiązana z tokenem."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/controllers/main.py:0
msgid "PayU: this payment was already processed."
msgstr "PayU: ta płatność została już przetworzona."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/controllers/main.py:0
msgid "PayU: unknown payment."
msgstr "PayU: nieznana płatność."

#. module: payment_payu_gpo
#: model:ir.model,name:payment_payu_gpo.model_payment_provider
msgid "Payment Provider"
msgstr "Dostawca płatności"

#. module: payment_payu_gpo
#: model:ir.model,name:payment_payu_gpo.model_payment_token
msgid "Payment Token"
msgstr "Token płatności"

#. module: payment_payu_gpo
#: model:ir.model,name:payment_payu_gpo.model_payment_transaction
msgid "Payment Transaction"
msgstr "Transakcja płatnicza"

#. module: payment_payu_gpo
#. odoo-javascript
#: code:addons/payment_payu_gpo/static/src/js/payment_form.esm.js:0
msgid "Payment processing failed"
msgstr "Przetwarzanie płatności nie powiodło się"

#. module: payment_payu_gpo
#. odoo-javascript
#: code:addons/payment_payu_gpo/static/src/js/payment_form.esm.js:0
msgid "Please enter the name on the card."
msgstr "Wpisz imię i nazwisko widniejące na karcie."

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_token__payu_gpo_recurring
msgid ""
"Saved for scheduled recurring charges (recurring=STANDARD); other cards are "
"charged as cards on file (cardOnFile=STANDARD_MERCHANT)."
msgstr ""
"Zapisana do zaplanowanych obciążeń cyklicznych (recurring=STANDARD); "
"pozostałe karty są obciążane jako karty zapisane "
"(cardOnFile=STANDARD_MERCHANT)."

#. module: payment_payu_gpo
#: model:ir.model.fields,field_description:payment_payu_gpo.field_payment_provider__payu_gpo_second_key
msgid "Second key (MD5)"
msgstr "Drugi klucz (MD5)"

#. module: payment_payu_gpo
#. odoo-javascript
#: code:addons/payment_payu_gpo/static/src/js/payment_form.esm.js:0
msgid "The card could not be read. Please try again."
msgstr "Nie udało się odczytać karty. Spróbuj ponownie."

#. module: payment_payu_gpo
#. odoo-javascript
#: code:addons/payment_payu_gpo/static/src/js/payment_form.esm.js:0
msgid "The card form of PayU could not be loaded. Please reload the page."
msgstr "Nie udało się załadować formularza karty PayU. Odśwież stronę."

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_transaction__payu_gpo_recurring
msgid ""
"The card is saved for scheduled recurring charges (recurring=FIRST) rather "
"than as a card on file."
msgstr ""
"Karta jest zapisana do zaplanowanych obciążeń cyklicznych (recurring=FIRST),"
" a nie jako karta zapisana."

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_provider__code
msgid "The technical code of this payment provider."
msgstr "Kod techniczny tego dostawcy płatności."

#. module: payment_payu_gpo
#: model:ir.model.fields,help:payment_payu_gpo.field_payment_provider__payu_gpo_second_key
msgid "Used to verify the OpenPayu-Signature of notifications."
msgstr "Służy do weryfikacji podpisu OpenPayu-Signature powiadomień."

#. module: payment_payu_gpo
#. odoo-python
#: code:addons/payment_payu_gpo/models/payment_transaction.py:0
msgid ""
"Your bank asks for the security code (CVV) of the card, which this payment "
"form cannot send yet. Please pay with another card."
msgstr ""
"Twój bank wymaga kodu bezpieczeństwa (CVV) karty, którego ten formularz "
"płatności nie może jeszcze przesłać. Zapłać inną kartą."

#. module: payment_payu_gpo
#: model_terms:payment.provider,auth_msg:payment_payu_gpo.payment_provider_payu_gpo
msgid "Your payment has been authorized."
msgstr "Twoja płatność została autoryzowana."

#. module: payment_payu_gpo
#: model_terms:payment.provider,cancel_msg:payment_payu_gpo.payment_provider_payu_gpo
msgid "Your payment has been cancelled."
msgstr "Twoja płatność została anulowana."

#. module: payment_payu_gpo
#: model_terms:payment.provider,pending_msg:payment_payu_gpo.payment_provider_payu_gpo
msgid ""
"Your payment has been successfully processed but is waiting for approval."
msgstr "Twoja płatność została przetworzona i oczekuje na zatwierdzenie."

#. module: payment_payu_gpo
#: model_terms:payment.provider,done_msg:payment_payu_gpo.payment_provider_payu_gpo
msgid "Your payment has been successfully processed."
msgstr "Twoja płatność została pomyślnie przetworzona."
